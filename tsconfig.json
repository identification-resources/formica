{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./lib",
    "target": "es6",

    "lib": [
        "ES2021.String"
    ],

    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,

    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true
  },
  "include": ["./src/**/*"]
}
